<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dragonfly_arm">
  <xacro:arg name="use_sim_time" default="true"/>

  <material name="dragonfly_blue">
    <color rgba="0.10 0.38 0.78 1.0"/>
  </material>
  <material name="dragonfly_dark">
    <color rgba="0.10 0.12 0.16 1.0"/>
  </material>
  <material name="dragonfly_orange">
    <color rgba="0.95 0.36 0.08 1.0"/>
  </material>
  <material name="dragonfly_silver">
    <color rgba="0.62 0.66 0.72 1.0"/>
  </material>

  <xacro:macro name="box_inertial" params="mass x y z origin_xyz">
    <inertial>
      <origin xyz="${origin_xyz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y * y + z * z) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (x * x + z * z) / 12.0}" iyz="0"
        izz="${mass * (x * x + y * y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass radius length origin_xyz">
    <inertial>
      <origin xyz="${origin_xyz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0 * radius * radius + length * length) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (3.0 * radius * radius + length * length) / 12.0}" iyz="0"
        izz="${mass * radius * radius / 2.0}"/>
    </inertial>
  </xacro:macro>

  <link name="world"/>
  <gazebo reference="world">
    <static>true</static>
  </gazebo>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.16" length="0.12"/></geometry>
      <material name="dragonfly_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.16" length="0.12"/></geometry>
    </collision>
    <xacro:cylinder_inertial mass="12.0" radius="0.16" length="0.12" origin_xyz="0 0 0.06"/>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${pi}" upper="${pi}" effort="120" velocity="1.2"/>
    <dynamics damping="0.60" friction="0.05"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry><cylinder radius="0.10" length="0.18"/></geometry>
      <material name="dragonfly_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry><cylinder radius="0.10" length="0.18"/></geometry>
    </collision>
    <xacro:cylinder_inertial mass="8.0" radius="0.10" length="0.18" origin_xyz="0 0 0.09"/>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.30" upper="2.30" effort="100" velocity="1.2"/>
    <dynamics damping="0.80" friction="0.05"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0.17" rpy="0 0 0"/>
      <geometry><box size="0.11 0.13 0.34"/></geometry>
      <material name="dragonfly_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.17" rpy="0 0 0"/>
      <geometry><box size="0.11 0.13 0.34"/></geometry>
    </collision>
    <xacro:box_inertial mass="6.0" x="0.11" y="0.13" z="0.34" origin_xyz="0 0 0.17"/>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.34" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.50" upper="2.50" effort="80" velocity="1.3"/>
    <dynamics damping="0.65" friction="0.04"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><box size="0.09 0.11 0.30"/></geometry>
      <material name="dragonfly_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><box size="0.09 0.11 0.30"/></geometry>
    </collision>
    <xacro:box_inertial mass="4.0" x="0.09" y="0.11" z="0.30" origin_xyz="0 0 0.15"/>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-${pi}" upper="${pi}" effort="40" velocity="1.8"/>
    <dynamics damping="0.35" friction="0.03"/>
  </joint>

  <link name="wrist_1_link">
    <visual>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry><cylinder radius="0.07" length="0.14"/></geometry>
      <material name="dragonfly_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry><cylinder radius="0.07" length="0.14"/></geometry>
    </collision>
    <xacro:cylinder_inertial mass="2.0" radius="0.07" length="0.14" origin_xyz="0 0 0.07"/>
  </link>

  <joint name="joint_5" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.10" upper="2.10" effort="30" velocity="1.8"/>
    <dynamics damping="0.30" friction="0.02"/>
  </joint>

  <link name="wrist_2_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.12"/></geometry>
      <material name="dragonfly_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.12"/></geometry>
    </collision>
    <xacro:cylinder_inertial mass="1.2" radius="0.06" length="0.12" origin_xyz="0 0 0.06"/>
  </link>

  <joint name="joint_6" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-${pi}" upper="${pi}" effort="20" velocity="2.0"/>
    <dynamics damping="0.25" friction="0.02"/>
  </joint>

  <link name="tool0">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><box size="0.06 0.10 0.12"/></geometry>
      <material name="dragonfly_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><box size="0.06 0.10 0.12"/></geometry>
    </collision>
    <xacro:box_inertial mass="0.8" x="0.06" y="0.10" z="0.12" origin_xyz="0 0 0.06"/>
  </link>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <xacro:macro name="controlled_joint" params="name lower upper">
      <joint name="${name}">
        <command_interface name="position">
          <param name="min">${lower}</param>
          <param name="max">${upper}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:controlled_joint name="joint_1" lower="-${pi}" upper="${pi}"/>
    <xacro:controlled_joint name="joint_2" lower="-2.30" upper="2.30"/>
    <xacro:controlled_joint name="joint_3" lower="-2.50" upper="2.50"/>
    <xacro:controlled_joint name="joint_4" lower="-${pi}" upper="${pi}"/>
    <xacro:controlled_joint name="joint_5" lower="-2.10" upper="2.10"/>
    <xacro:controlled_joint name="joint_6" lower="-${pi}" upper="${pi}"/>
  </ros2_control>

  <gazebo reference="base_link"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="shoulder_link"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="upper_arm_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="forearm_link"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="wrist_1_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="wrist_2_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="tool0"><material>Gazebo/Black</material></gazebo>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>${xacro.abs_filename('../config/controllers.yaml')}</parameters>
    </plugin>
  </gazebo>
</robot>
