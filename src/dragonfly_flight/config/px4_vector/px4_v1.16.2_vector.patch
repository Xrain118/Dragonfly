+
+#pragma once
+#include "control_allocation/actuator_effectiveness/ActuatorEffectiveness.hpp"
+
+class ActuatorEffectivenessDragonfly : public ActuatorEffectiveness
+{
+public:
+	const char *name() const override { return "Dragonfly dual-axis tilt"; }
+	void getDesiredAllocationMethod(AllocationMethod out[MAX_NUM_MATRICES]) const override
+	{
+		out[0] = AllocationMethod::DRAGONFLY;
+	}
+	bool getEffectivenessMatrix(Configuration &configuration, EffectivenessUpdateReason reason) override
+	{
+		if (reason == EffectivenessUpdateReason::NO_EXTERNAL_UPDATE) { return false; }
+
+		// Register exactly six motors followed by six servos. Nonlinear
+		// allocation and achieved wrench are supplied by the dedicated class.
+		for (int i = 0; i < 6; ++i) {
+			configuration.addActuator(ActuatorType::MOTORS, matrix::Vector3f(), matrix::Vector3f(0.f, 0.f, -1.f));
+		}
+
+		for (int i = 0; i < 6; ++i) {
+			configuration.addActuator(ActuatorType::SERVOS, matrix::Vector3f(), matrix::Vector3f());
+		}
+
+		return true;
+	}
+};
