+// Parameter metadata is collected by the PX4 parameter generator.
+
+/**
+ * Dragonfly en (SI, body FLU).
+ *
+ * @group Dragonfly Vector
+ */
+PARAM_DEFINE_INT32(DF_EN, 0);
+
+/**
+ * Dragonfly mass (SI, body FLU).
+ *
+ * @group Dragonfly Vector
+ */
+PARAM_DEFINE_FLOAT(DF_MASS, 4.628f);
+
+/**
+ * Dragonfly radius (SI, body FLU).
+ *
+ * @group Dragonfly Vector
+ */
+PARAM_DEFINE_FLOAT(DF_RADIUS, 0.692820323f);
+
+/**
+ * Dragonfly spacing (SI, body FLU).
+ *
+ * @group Dragonfly Vector
+ */
+PARAM_DEFINE_FLOAT(DF_SPACING, 0.36f);
+
+/**
+ * Dragonfly height (SI, body FLU).
+ *
+ * @group Dragonfly Vector
+ */
+PARAM_DEFINE_FLOAT(DF_HEIGHT, 0.06f);
+
+/**
+ * Dragonfly hub (SI, body FLU).
+ *
+ * @group Dragonfly Vector
+ */
+PARAM_DEFINE_FLOAT(DF_HUB, 0.038f);
+
+/**
+ * Dragonfly fmax (SI, body FLU).
+ *
+ * @group Dragonfly Vector
+ */
+PARAM_DEFINE_FLOAT(DF_FMAX, 15.13356f);
+
+/**
+ * Dragonfly moment (SI, body FLU).
+ *
+ * @group Dragonfly Vector
+ */
+PARAM_DEFINE_FLOAT(DF_MOMENT, 0.02f);
+
+/**
+ * Dragonfly tilt (SI, body FLU).
+ *
+ * @group Dragonfly Vector
+ */
+PARAM_DEFINE_FLOAT(DF_TILT, 1.570796327f);
+
+/**
+ * Dragonfly tiltrate (SI, body FLU).
+ *
+ * @group Dragonfly Vector
+ */
+PARAM_DEFINE_FLOAT(DF_TILTRATE, 0.5f);
+
