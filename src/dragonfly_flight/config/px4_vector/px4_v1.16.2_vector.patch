+#include "ControlAllocationDragonfly.hpp"
+#include <lib/parameters/param.h>
+
+static float read_float(const char *name, float fallback)
+{
+	const param_t handle = param_find(name);
+	float value = fallback;
+
+	if (handle != PARAM_INVALID) { param_get(handle, &value); }
+
+	return PX4_ISFINITE(value) ? value : fallback;
+}
+
+void ControlAllocationDragonfly::updateParameters()
+{
+	auto &g = _solver.geometry;
+	g.mass = read_float("DF_MASS", g.mass);
+	g.radius = read_float("DF_RADIUS", g.radius);
+	g.spacing = read_float("DF_SPACING", g.spacing);
+	g.height = read_float("DF_HEIGHT", g.height);
+	g.hub_height = read_float("DF_HUB", g.hub_height);
+	g.max_thrust = read_float("DF_FMAX", g.max_thrust);
+	g.moment = read_float("DF_MOMENT", g.moment);
+	g.tilt_limit = read_float("DF_TILT", g.tilt_limit);
+	g.tilt_rate = read_float("DF_TILTRATE", g.tilt_rate);
+	g.accel_scale = read_float("DF_ACC", g.accel_scale);
+	g.rate_scale = read_float("DF_RATE", g.rate_scale);
+	g.com = matrix::Vector3f(read_float("DF_COM_X", 0.f), read_float("DF_COM_Y", 0.f), read_float("DF_COM_Z", 0.f));
+	g.inertia.zero();
+	g.inertia(0, 0) = read_float("DF_IXX", 1.f);
+	g.inertia(1, 1) = read_float("DF_IYY", 1.f);
+	g.inertia(2, 2) = read_float("DF_IZZ", 1.f);
+	g.inertia(0, 1) = g.inertia(1, 0) = read_float("DF_IXY", 0.f);
+	g.inertia(0, 2) = g.inertia(2, 0) = read_float("DF_IXZ", 0.f);
+	g.inertia(1, 2) = g.inertia(2, 1) = read_float("DF_IYZ", 0.f);
+}
+
+void ControlAllocationDragonfly::allocate()
+{
+	_prev_actuator_sp = _actuator_sp;
+	const hrt_abstime now = hrt_absolute_time();
+	const float dt = _last_run ? math::constrain((now - _last_run) * 1e-6f, .001f, .03f) : .004f;
+	_last_run = now;
+	const auto &g = _solver.geometry;
+	// PX4 messages are always FRD. The URDF allocation math is body FLU.
+	const matrix::Vector3f force(_control_sp(3)*g.mass * g.accel_scale,
+				     -_control_sp(4)*g.mass * g.accel_scale,
+				     -_control_sp(5)*g.mass * g.accel_scale);
+	const matrix::Vector3f angular(_control_sp(0), -_control_sp(1), -_control_sp(2));
+	const matrix::Vector3f torque = g.inertia * (angular * g.rate_scale) + g.com.cross(force);
+	DragonflyAllocation::Wrench demand;
+
+	for (int i = 0; i < 3; ++i) { demand(i) = force(i); demand(i + 3) = torque(i); }
+
+	if (!_solver.solve(demand, dt)) {
+		if (++_failures >= 3) { _actuator_sp.zero(); }
+
+		return;
+	}
+
+	_failures = 0;
+	_actuator_sp.zero();
+
+	for (int i = 0; i < 6; ++i) {
+		// Gazebo ESC consumes normalized angular speed when THR_MDL_FAC=0.
+		_actuator_sp(i) = sqrtf(math::constrain(_solver.state(i) / g.max_thrust, 0.f, 1.f));
+		_actuator_sp(i + 6) = _solver.state(i + 6) / g.tilt_limit;
+	}
+}
+
+matrix::Vector<float, ControlAllocation::NUM_AXES> ControlAllocationDragonfly::getAllocatedControl() const
+{
+	auto state = _solver.state;
+	const auto &g = _solver.geometry;
+
+	for (int i = 0; i < 6; ++i) {
+		state(i) = math::sq(math::constrain(_actuator_sp(i), 0.f, 1.f)) * g.max_thrust;
+		state(i + 6) = math::constrain(_actuator_sp(i + 6), -1.f, 1.f) * g.tilt_limit;
+	}
+
+	const auto w = _solver.wrench(state);
+	const matrix::Vector3f force(w(0), w(1), w(2));
+	const matrix::Vector3f torque = matrix::Vector3f(w(3), w(4), w(5)) - g.com.cross(force);
+	matrix::Matrix3f inverse;
+	matrix::Vector3f angular;
+
+	if (matrix::inv(g.inertia, inverse)) { angular = inverse * torque / g.rate_scale; }
+
+	matrix::Vector<float, NUM_AXES> control;
+	control(0) = angular(0); control(1) = -angular(1); control(2) = -angular(2);
+	control(3) = force(0) / (g.mass * g.accel_scale);
+	control(4) = -force(1) / (g.mass * g.accel_scale);
+	control(5) = -force(2) / (g.mass * g.accel_scale);
+	return control;
+}
