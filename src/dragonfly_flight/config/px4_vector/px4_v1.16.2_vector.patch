+
+#pragma once
+
+#include <matrix/matrix/math.hpp>
+#include <mathlib/mathlib.h>
+#include <cmath>
+
+// Geometry is expressed in body FLU, as in the URDF. SI units throughout.
+struct DragonflyGeometry {
+	float mass{4.628f}, radius{0.692820323f}, spacing{0.36f};
+	float height{0.06f}, hub_height{0.038f}, max_thrust{15.13356f};
+	float moment{0.02f}, tilt_limit{1.570796327f}, tilt_rate{0.5f};
+	float accel_scale{19.62f}, rate_scale{26.6666667f};
+	matrix::Vector3f com;
+	matrix::Matrix3f inertia;
+};
+
+class DragonflyAllocation
+{
+public:
+	using State = matrix::Vector<float, 12>;
+	using Wrench = matrix::Vector<float, 6>;
+	DragonflyGeometry geometry;
+	State state;
+	bool initialized{false};
+
+	matrix::Matrix<float, 6, 6> effectiveness(const State &z) const
+	{
+		matrix::Matrix<float, 6, 6> a;
+
+		for (int k = 0; k < 3; ++k) {
+			const float yaw = k * 2.f * M_PI_F / 3.f;
+			const float ca = cosf(z(6 + 2 * k)), sa = sinf(z(6 + 2 * k));
+			const float cb = cosf(z(7 + 2 * k)), sb = sinf(z(7 + 2 * k));
+			const matrix::Dcmf rz(matrix::Eulerf(0.f, 0.f, yaw));
+			const matrix::Dcmf rx(matrix::Eulerf(z(6 + 2 * k), 0.f, 0.f));
+			const matrix::Dcmf ry(matrix::Eulerf(0.f, z(7 + 2 * k), 0.f));
+			const matrix::Dcmf rotation = rz * rx * ry;
+			const matrix::Vector3f axis = rz * matrix::Vector3f(sb, -sa * cb, ca * cb);
+			const matrix::Vector3f center = rz * matrix::Vector3f(geometry.radius, 0.f, geometry.height);
+
+			for (int side = 0; side < 2; ++side) {
+				const float sign = side == 0 ? 1.f : -1.f;
+				const matrix::Vector3f p = center + rotation * matrix::Vector3f(0.f, sign * geometry.spacing / 2.f,
+							   geometry.hub_height);
+				const matrix::Vector3f torque = p.cross(axis) - sign * geometry.moment * axis;
+
+				for (int i = 0; i < 3; ++i) {
+					a(i, 2 * k + side) = axis(i);
+					a(i + 3, 2 * k + side) = torque(i);
+				}
+			}
+		}
+
+		return a;
+	}
+
+	Wrench wrench(const State &z) const
+	{
+		matrix::Vector<float, 6> forces;
+
+		for (int i = 0; i < 6; ++i) { forces(i) = z(i); }
+
+		return effectiveness(z) * forces;
+	}
+
+	// Bounded least squares active-set solver. Double precision avoids the
+	// poorly conditioned motor nullspace of three paired propulsion units.
+	static bool bounded(const double h[12][12], const double b[12], const double lo[12],
+			    const double hi[12], double x[12])
+	{
+		int active[12] {};
+
+		for (int i = 0; i < 12; ++i) {
+			x[i] = fmax(lo[i], fmin(hi[i], 0.));
+
+			if (x[i] <= lo[i] + 1e-10) { active[i] = -1; }
+
+			if (x[i] >= hi[i] - 1e-10) { active[i] = 1; }
+		}
+
+		for (int iteration = 0; iteration < 100; ++iteration) {
+			double a[12][13] {};
+
+			for (int i = 0; i < 12; ++i) {
+				if (active[i]) { a[i][i] = 1.; a[i][12] = x[i]; continue; }
+
+				a[i][12] = b[i];
+
+				for (int j = 0; j < 12; ++j) {
+					if (active[j]) { a[i][12] -= h[i][j] * x[j]; }
+
+					else { a[i][j] = h[i][j]; }
+				}
+			}
+
+			for (int k = 0; k < 12; ++k) {
+				int pivot = k;
+
+				for (int i = k + 1; i < 12; ++i) { if (fabs(a[i][k]) > fabs(a[pivot][k])) { pivot = i; } }
+
+				if (fabs(a[pivot][k]) < 1e-12) { return false; }
+
+				for (int j = k; j < 13; ++j) { const double tmp = a[k][j]; a[k][j] = a[pivot][j]; a[pivot][j] = tmp; }
+
+				const double divisor = a[k][k];
+
+				for (int j = k; j < 13; ++j) { a[k][j] /= divisor; }
+
+				for (int i = 0; i < 12; ++i) {
+					if (i == k) { continue; }
+
+					const double factor = a[i][k];
+
+					for (int j = k; j < 13; ++j) { a[i][j] -= factor * a[k][j]; }
+				}
+			}
+
+			double alpha = 1.; int hit = -1, hit_side = 0;
+
+			for (int i = 0; i < 12; ++i) {
+				if (active[i]) { continue; }
+
+				const double d = a[i][12] - x[i];
+
+				if (d > 1e-12 && a[i][12] > hi[i]) {
+					const double candidate = (hi[i] - x[i]) / d;
+
+					if (candidate < alpha) { alpha = candidate; hit = i; hit_side = 1; }
+
+				} else if (d < -1e-12 && a[i][12] < lo[i]) {
+					const double candidate = (lo[i] - x[i]) / d;
+
+					if (candidate < alpha) { alpha = candidate; hit = i; hit_side = -1; }
+				}
+			}
+
+			for (int i = 0; i < 12; ++i) { x[i] = fmax(lo[i], fmin(hi[i], x[i] + alpha * (a[i][12] - x[i]))); }
+
+			if (hit >= 0) { active[hit] = hit_side; continue; }
+
+			int release = -1; double worst = 1e-8;
+
+			for (int i = 0; i < 12; ++i) {
+				if (!active[i]) { continue; }
+
+				double gradient = -b[i];
+
+				for (int j = 0; j < 12; ++j) { gradient += h[i][j] * x[j]; }
+
+				const double violation = active[i] * gradient;
+
+				if (violation > worst) { worst = violation; release = i; }
+			}
+
+			if (release < 0) { return true; }
+
+			active[release] = 0;
+		}
+
+		return false;
+	}
+
+	bool solve(const Wrench &desired, float dt)
+	{
+		if (!desired.isAllFinite() || !PX4_ISFINITE(dt)) { return false; }
+
+		if (!initialized) {
+			state.zero();
+
+			for (int i = 0; i < 6; ++i) { state(i) = geometry.mass * 9.81f / 6.f; }
+
+			initialized = true;
+		}
+
+		State lower, upper, scale, nominal;
+
+		for (int i = 0; i < 12; ++i) {
+			if (i < 6) {
+				lower(i) = 0.f; upper(i) = geometry.max_thrust; scale(i) = geometry.max_thrust;
+				nominal(i) = math::constrain(desired(2) / 6.f, 0.f, geometry.max_thrust);
+
+			} else {
+				lower(i) = math::max(-geometry.tilt_limit, state(i) - geometry.tilt_rate * dt);
+				upper(i) = math::min(geometry.tilt_limit, state(i) + geometry.tilt_rate * dt);
+				scale(i) = 1.f;
+			}
+		}
+
+		State z = state;
+		const float weight[6] = {1.f, 1.f, 2.f, 3.f, 3.f, 2.f};
+
+		for (int iteration = 0; iteration < 3; ++iteration) {
+			const Wrench w = wrench(z);
+			matrix::Matrix<float, 6, 12> jacobian;
+			const auto motors = effectiveness(z);
+
+			for (int i = 0; i < 6; ++i) {
+				for (int j = 0; j < 6; ++j) { jacobian(i, j) = motors(i, j); }
+			}
+
+			for (int j = 6; j < 12; ++j) {
+				State plus = z, minus = z;
+				plus(j) += 1e-4f; minus(j) -= 1e-4f;
+				const Wrench column = (wrench(plus) - wrench(minus)) / 2e-4f;
+
+				for (int i = 0; i < 6; ++i) { jacobian(i, j) = column(i); }
+			}
+
+			double h[12][12] {}, b[12] {}, lo[12], hi[12], x[12];
+
+			for (int j = 0; j < 12; ++j) {
+				lo[j] = (lower(j) - z(j)) / scale(j); hi[j] = (upper(j) - z(j)) / scale(j);
+				b[j] = .0064 * double((nominal(j) - z(j)) / scale(j));
+
+				for (int k = 0; k < 12; ++k) {
+					h[j][k] = j == k ? .0064 : 0.;
+
+					for (int i = 0; i < 6; ++i) {
+						h[j][k] += double(weight[i] * jacobian(i, j) * scale(j)) * double(weight[i] * jacobian(i, k) * scale(k));
+					}
+				}
+
+				for (int i = 0; i < 6; ++i) { b[j] += double(weight[i] * jacobian(i, j) * scale(j)) * double(weight[i] * (desired(i) - w(i))); }
+			}
+
+			if (!bounded(h, b, lo, hi, x)) { return false; }
+
+			for (int i = 0; i < 12; ++i) { z(i) = math::constrain(z(i) + float(x[i]) * scale(i), lower(i), upper(i)); }
+		}
+
+		if (!z.isAllFinite()) { return false; }
+
+		state = z;
+		return true;
+	}
+};
